{
  "version": "2",
  "run": {
    "timeout": "10m"
  },
  "linters": {
    "enable": [
      "modernize"
    ],
    "exclusions": {
      "paths": [
        "vendor"
      ],
      "presets": [
        "comments",
        "std-error-handling"
      ],
      "rules": [
        {
          "linters": [
            "staticcheck"
          ],
          "path": "pkg/deploy/deploy.go",
          "exclude": [
            "ST1012"
          ]
        }
      ]
    },
    "settings": {
      "modernize": {
        "disable": [
          "any",
          "atomictypes",
          "embedlit",
          "errorsastype",
          "forvar",
          "importcomment",
          "mapsloop",
          "minmax",
          "omitzero",
          "plusbuild",
          "rangeint",
          "reflecttypeassert",
          "reflecttypefor",
          "slicesbackward",
          "slicesclip",
          "slicescontains",
          "slicessort",
          "stditerators",
          "stringsbuilder",
          "stringscut",
          "stringscutprefix",
          "stringsseq",
          "testingcontext",
          "unsafefuncs",
          "waitgroupgo"
        ]
      },
      "staticcheck": {
        "checks": [
          "all",
          "-ST1003",
          "-ST1005",
          "-SA1019",
          "-QF1003",
          "-QF1007",
          "-QF1008"
        ]
      }
    }
  },
  "formatters": {
    "exclusions": {
      "paths": [
        "vendor"
      ]
    }
  }
}
