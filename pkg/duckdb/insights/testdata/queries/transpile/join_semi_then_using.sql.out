{
  "sql": "WITH __inngest_runs AS NOT MATERIALIZED (SELECT * FROM inngest_local.insights_runs(?, ?)), __inngest_extended_trace_spans AS NOT MATERIALIZED (SELECT * FROM inngest_local.insights_extended_trace_spans(?, ?)), __inngest_metadata AS NOT MATERIALIZED (SELECT * FROM inngest_local.insights_metadata(?, ?)) SELECT * FROM __inngest_runs AS r SEMI JOIN __inngest_extended_trace_spans AS e ON r.run_id = e.run_id INNER JOIN __inngest_metadata AS m USING (run_id) LIMIT 1000",
