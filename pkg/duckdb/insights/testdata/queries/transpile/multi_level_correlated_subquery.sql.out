{
  "sql": "WITH __inngest_runs AS NOT MATERIALIZED (SELECT * FROM inngest.insights_runs(?, ?)), __inngest_events AS NOT MATERIALIZED (SELECT * FROM inngest.insights_events(?, ?)), __inngest_extended_trace_spans AS NOT MATERIALIZED (SELECT * FROM inngest.insights_extended_trace_spans(?, ?)) SELECT run_id FROM __inngest_runs AS runs WHERE EXISTS (SELECT 1 FROM __inngest_events AS events WHERE EXISTS (SELECT 1 FROM __inngest_extended_trace_spans AS extended_trace_spans WHERE extended_trace_spans.run_id = runs.run_id)) LIMIT 1000",
