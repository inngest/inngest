{
  "sql": "WITH __inngest_runs AS NOT MATERIALIZED (SELECT * FROM inngest.insights_runs(?, ?)), __inngest_events AS NOT MATERIALIZED (SELECT * FROM inngest.insights_events(?, ?)) SELECT now()::TIMESTAMP AS t FROM __inngest_runs AS runs UNION ALL SELECT now()::TIMESTAMP FROM __inngest_runs AS runs ORDER BY now()::TIMESTAMP LIMIT 5 OFFSET (SELECT count(*) FROM __inngest_events AS events)",
