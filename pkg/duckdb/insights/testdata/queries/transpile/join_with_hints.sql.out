{
  "sql": "WITH __inngest_runs AS NOT MATERIALIZED (SELECT * FROM inngest.insights_runs(?, ?)), __inngest_extended_trace_spans AS NOT MATERIALIZED (SELECT * FROM inngest.insights_extended_trace_spans(?, ?)) SELECT runs.run_id, extended_trace_spans.attributes -\u003e\u003e '_inngest.function.slug' FROM __inngest_runs AS runs INNER JOIN __inngest_extended_trace_spans AS extended_trace_spans ON runs.run_id = extended_trace_spans.run_id LIMIT 1000",
