INPUT
event.name == "y" && (event.data.a == 1 || output.ok == true)

EVENT SQL
((x::JSON->>?) = ?)

EVENT ARGS
[$.name y]

OUTPUT SQL
(len(list_filter(json_transform(inputs, '["JSON"]'), lambda x: (TRY_CAST((x::JSON->>?) AS DOUBLE) = ?))) > 0 OR ((output::JSON->>?) = ?))

OUTPUT ARGS
[$.data.a 1 $.data.ok true]
