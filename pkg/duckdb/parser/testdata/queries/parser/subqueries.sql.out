-- SELECT a FROM t WHERE EXISTS (SELECT 1 FROM other WHERE other.id = t.id)
SelectStatement
  SelectItem()
    Ident(a)
  FromClause
    BaseTableRef(t,alias=)
  SubqueryExpr(exists=true,not=false)
    SelectStatement
      SelectItem()
        Literal(1,1)
      FromClause
        BaseTableRef(other,alias=)
      BinaryExpr(=)
        Ident(other.id)
        Ident(t.id)

-- SELECT (SELECT max(a) FROM t) AS m FROM other
SelectStatement
  SelectItem(m)
    SubqueryExpr(exists=false,not=false)
      SelectStatement
        SelectItem()
          FunctionExpr(max,distinct=false)
            Ident(a)
        FromClause
          BaseTableRef(t,alias=)
  FromClause
    BaseTableRef(other,alias=)

-- SELECT a FROM t WHERE a = ANY (SELECT id FROM other) AND b >= ALL ([1, 2]) AND c <> ANY (tags);
SelectStatement
  SelectItem()
    Ident(a)
  FromClause
    BaseTableRef(t,alias=)
  BinaryExpr(AND)
    BinaryExpr(AND)
      QuantifiedExpr(= ANY)
        Ident(a)
        SubqueryExpr(exists=false,not=false)
          SelectStatement
            SelectItem()
              Ident(id)
            FromClause
              BaseTableRef(other,alias=)
      QuantifiedExpr(>= ALL)
        Ident(b)
        ListExpr(paren=false)
          Literal(1,1)
          Literal(1,2)
    QuantifiedExpr(<> ANY)
      Ident(c)
      Ident(tags)

