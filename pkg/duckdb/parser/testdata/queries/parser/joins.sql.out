-- SELECT * FROM (SELECT id FROM t) sub
SelectStatement
  SelectItem()
    StarExpr(,exclude=[])
  FromClause
    TableSubqueryRef(alias=sub)
      SelectStatement
        SelectItem()
          Ident(id)
        FromClause
          BaseTableRef(t,alias=)

-- SELECT * FROM a, LATERAL (SELECT * FROM b WHERE b.id = a.id) sub
SelectStatement
  SelectItem()
    StarExpr(,exclude=[])
  FromClause
    BaseTableRef(a,alias=)
    TableSubqueryRef(alias=sub)
      SelectStatement
        SelectItem()
          StarExpr(,exclude=[])
        FromClause
          BaseTableRef(b,alias=)
        BinaryExpr(=)
          Ident(b.id)
          Ident(a.id)

-- SELECT * FROM range(10) t
SelectStatement
  SelectItem()
    StarExpr(,exclude=[])
  FromClause
    TableFunctionRef(range,alias=t)
      Literal(1,10)

