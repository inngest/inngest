-- SELECT * FROM a JOIN b ON a.id = b.id
SelectStatement
  SelectItem()
    StarExpr(,exclude=[])
  FromClause
    JoinRef(INNER,using=[])
      BaseTableRef(a,alias=)
      BaseTableRef(b,alias=)
      BinaryExpr(=)
        Ident(a.id)
        Ident(b.id)

